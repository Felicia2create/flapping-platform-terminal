.joint-list {
    flex-direction: column;
}

.joint-sliders-scroll {
    max-height: 220px;
}

.joint-slider-list {
    flex-direction: column;
    width: auto;
    flex-wrap: nowrap;
}

.action-button {
    font-size: var(--font-size);
    color: var(--color-text-light);
    background-color: var(--color-accent);
    border-width: 0;
    border-radius: 7px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 14px;
    padding-right: 14px;
    margin-top: 6px;
    margin-bottom: 4px;
    -unity-font-style: bold;
}

.action-button:hover {
    background-color: var(--color-accent2);
}

.action-button:active {
    background-color: rgb(0, 140, 158);
}

.button-row .action-button {
    font-size: var(--font-size-sm);
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
    flex-grow: 1;
}

.mode-button {
    font-size: var(--font-size-sm);
    color: var(--color-text-dim);
    background-color: rgba(230, 240, 252, 0.7);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 6px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
    flex-grow: 1;
    margin: 2px;
}

.mode-button:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
}

.stop-button {
    font-size: 19px;
    color: var(--color-text-light);
    background-color: var(--color-danger);
    border-width: 0;
    border-radius: 9px;
    padding: 12px;
    margin-top: 10px;
    -unity-font-style: bold;
}

.stop-button:hover {
    background-color: rgb(228, 70, 58);
}

.stop-button:active {
    background-color: rgb(170, 40, 35);
}

.button-row {
    flex-direction: row;
    margin-top: 4px;
}

.ee-input-row {
    flex-direction: row;
    align-items: center;
    margin: 2px 0;
}

.ee-label {
    font-size: var(--font-size-sm);
    color: var(--color-text-dim);
    width: 18px;
}

.ee-input {
    font-size: var(--font-size-sm);
    width: 72px;
    margin-right: 4px;
}

.slider-control {
    margin: 4px 0;
}

.status-bar {
    height: var(--statusbar-height);
    min-height: var(--statusbar-height);
    background-color: rgba(224, 240, 255, 0.68);
    flex-direction: row;
    align-items: center;
    padding-left: 12px;
    padding-right: 12px;
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: var(--radius);
    margin-top: 10px;
}

.status-message {
    font-size: var(--font-size-sm);
    color: var(--color-text-dim);
    -unity-font-style: bold;
    flex-grow: 1;
}

.status-time {
    font-size: var(--font-size-sm);
    color: var(--color-text-dim);
    -unity-font-style: bold;
}

.frame-selector {
    font-size: var(--font-size-sm);
    flex-grow: 1;
}

.mode-hint {
    font-size: var(--font-size-sm);
    color: var(--color-accent);
    padding: 3px 6px;
    margin: 2px 0;
    border-radius: var(--radius);
    background-color: rgba(216, 235, 255, 0.58);
}

.plan-status {
    font-size: var(--font-size-sm);
    color: var(--color-text-dim);
    padding: 2px 6px;
    margin: 2px 0;
    border-radius: var(--radius);
}

.plan-status.planning {
    color: rgb(220, 180, 40);
    background-color: rgba(220, 180, 40, 0.1);
}

.plan-status.failed {
    color: var(--color-danger);
    background-color: rgba(200, 55, 50, 0.1);
}

.confirm-button {
    font-size: var(--font-size-sm);
    color: white;
    background-color: rgba(0, 156, 206, 0.86);
    border-width: 0;
    border-radius: var(--radius);
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 12px;
    padding-right: 12px;
    flex-grow: 1;
    margin: 2px;
}

.confirm-button:hover {
    background-color: rgb(0, 140, 158);
}

.cancel-button {
    font-size: var(--font-size-sm);
    color: var(--color-text);
    background-color: rgba(216, 235, 255, 0.62);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: var(--radius);
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 12px;
    padding-right: 12px;
    flex-grow: 1;
    margin: 2px;
}

.cancel-button:hover {
    background-color: var(--color-danger);
    color: white;
}

.target-data {
    color: var(--color-accent);
}

.left-panel-anim {
    width: 200px;
    background-color: var(--color-panel);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: var(--radius);
    padding: 14px 13px;
    margin-right: 10px;
    flex-direction: row;
    overflow: hidden;
}

.left-panel-anim.collapsed {
    width: 28px;
    padding: 4px;
}

.right-panel-anim {
    width: 300px;
    background-color: var(--color-panel);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: var(--radius);
    padding: 14px 13px;
    margin-left: 10px;
    flex-direction: row;
    overflow: hidden;
}

.right-panel-anim.collapsed {
    width: 28px;
    padding: 4px;
}

.panel-inner {
    flex-grow: 1;
    overflow: hidden;
}

.panel-collapse-btn {
    width: 24px;
    font-size: 14px;
    color: var(--color-text-dim);
    background-color: var(--color-surface);
    border-width: 0;
    border-radius: var(--radius);
    padding: 4px 0;
    -unity-text-align: middle-center;
}

.panel-collapse-btn:hover {
    color: var(--color-accent);
}

.center-view-anim {
    flex-grow: 1;
    background-color: transparent;
}

/* ── 动画播放控件 ── */

.animation-status {
    font-size: var(--font-size-sm);
    padding: 4px 8px;
    border-radius: var(--radius);
    background-color: rgba(216, 235, 255, 0.62);
    color: var(--color-text-dim);
    margin-bottom: 6px;
}
.animation-status.playing {
    color: rgb(0, 126, 180);
}
.animation-status.paused {
    color: var(--color-warning);
}

.play-button {
    font-size: var(--font-size-lg);
    color: var(--color-text-light);
    background-color: rgba(0, 156, 206, 0.88);
    border-width: 1px;
    border-color: rgba(184, 232, 255, 0.70);
    border-radius: 9px;
    padding: 12px;
    margin-top: 10px;
    -unity-font-style: bold;
}
.play-button:hover {
    background-color: rgba(25, 103, 206, 0.90);
}

.speed-row {
    flex-direction: row;
    align-items: center;
}
.speed-slider {
    flex-grow: 1;
}

.animation-mode-dropdown .unity-base-popup-field__input,
.animation-mode-dropdown .unity-base-field__input {
    font-size: var(--font-size);
    color: rgb(16, 73, 150);
    -unity-font-style: bold;
    background-color: rgba(216, 235, 255, 0.72);
    border-width: 1px;
    border-color: rgba(25, 103, 206, 0.62);
    border-radius: 6px;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 8px;
    padding-right: 8px;
}

.animation-mode-dropdown .unity-base-popup-field__input:hover,
.animation-mode-dropdown .unity-base-field__input:hover {
    background-color: rgba(232, 245, 255, 0.86);
    border-color: rgb(12, 72, 156);
}

.prototype-button-row {
    flex-direction: row;
}

.prototype-button {
    flex-grow: 1;
    font-size: 12px;
    color: rgb(16, 73, 150);
    background-color: rgba(216, 235, 255, 0.62);
    border-width: 1px;
    border-color: rgba(25, 103, 206, 0.48);
    border-radius: 6px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 6px;
    padding-right: 6px;
    margin-left: 3px;
    margin-right: 3px;
    -unity-font-style: bold;
}

.prototype-button:hover {
    background-color: rgba(232, 245, 255, 0.82);
}

.prototype-button.prototype-button-active {
    color: var(--color-text-light);
    background-color: rgba(25, 103, 206, 0.90);
    border-color: rgba(184, 232, 255, 0.78);
}

.closeup-card {
    background-color: rgba(12, 42, 82, 0.18);
    border-width: 1px;
    border-color: rgba(184, 232, 255, 0.52);
    border-radius: 8px;
    padding-top: 7px;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    margin-bottom: 6px;
}

.closeup-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
    padding-left: 8px;
    padding-right: 8px;
}

.closeup-title {
    font-size: var(--font-size-sm);
    color: rgb(18, 72, 150);
    -unity-font-style: bold;
}

.closeup-badge {
    font-size: 11px;
    color: white;
    background-color: rgba(0, 156, 206, 0.86);
    border-width: 1px;
    border-color: rgba(184, 232, 255, 0.62);
    border-radius: 999px;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 7px;
    padding-right: 7px;
    -unity-font-style: bold;
}

.closeup-image {
    align-self: stretch;
    width: 100%;
    height: 220px;
    background-color: rgba(8, 24, 48, 0.24);
    border-width: 1px;
    border-color: rgba(86, 155, 232, 0.34);
    border-radius: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.speed-value {
    font-size: var(--font-size);
    color: var(--color-accent);
    width: 52px;
    -unity-text-align: middle-center;
}

/* ── 路径选择（规范 §08 分段控件：选中段 = accent 填充白字） ── */
.path-list {
    flex-direction: column;
}

.path-button {
    font-size: var(--font-size);
    color: var(--color-text);
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 6px;
    padding-top: 9px;
    padding-bottom: 9px;
    padding-left: 12px;
    padding-right: 12px;
    margin-top: 0;
    margin-bottom: 6px;
    margin-left: 0;
    margin-right: 0;
    -unity-text-align: middle-left;
    -unity-font-style: bold;
}

.path-button:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
}

.path-button.path-active {
    color: var(--color-text-light);
    background-color: var(--color-accent);
    border-color: var(--color-accent);
}

/* ── 飞行参数折线图卡片（X 轴=时间） ── */
.chart-card {
    background-color: rgba(216, 235, 255, 0.50);
    border-width: 1px;
    border-color: rgba(86, 155, 232, 0.24);
    border-radius: 6px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 10px;
    padding-right: 10px;
    margin-bottom: 6px;
}

.chart-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2px;
}

.chart-title {
    font-size: var(--font-size-sm);
    color: rgba(75, 103, 142, 0.86);
    -unity-font-style: bold;
}

.chart-value {
    font-size: var(--font-size);
    color: var(--color-accent);
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.chart-plot {
    height: 40px;
}
