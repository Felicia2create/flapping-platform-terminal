.joint-list {
    flex-direction: column;
}

.joint-slider-list {
    flex-direction: column;
    width: auto;
    flex-wrap: nowrap;
}

/* ═══ 按钮体系：primary(青) / ghost(中性) / danger(红) ═══ */
.primary-button {
    font-size: var(--font-size-sm);
    color: var(--color-accent-dark);
    background-color: var(--color-accent);
    border-width: 1px;
    border-color: var(--color-accent-line);
    border-radius: var(--radius);
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    flex-grow: 1;
    margin: 2px;
    -unity-font-style: bold;
}

.primary-button:hover {
    background-color: rgb(64, 133, 220);
}

.primary-button:active {
    background-color: var(--color-accent-dim);
    color: rgb(255, 255, 255);
}

.ghost-button {
    font-size: var(--font-size-sm);
    color: var(--color-text-dim);
    background-color: transparent;
    border-width: 1px;
    border-color: var(--color-line);
    border-radius: var(--radius);
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    flex-grow: 1;
    margin: 2px;
    -unity-font-style: bold;
}

.ghost-button:hover {
    color: var(--color-text);
    border-color: var(--color-accent-dim);
    background-color: var(--color-accent-ghost);
}

.danger-button {
    font-size: var(--font-size-sm);
    color: rgb(255, 233, 234);
    background-color: var(--color-danger-deep);
    border-width: 1px;
    border-color: rgb(242, 109, 114);
    border-radius: var(--radius);
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    flex-grow: 1;
    margin: 2px;
    -unity-font-style: bold;
}

.danger-button:hover {
    background-color: rgb(194, 56, 61);
}

/* 兼容旧类名（逐步迁移期） */
.confirm-button {
    font-size: var(--font-size-sm);
    color: var(--color-accent-dark);
    background-color: var(--color-accent);
    border-width: 1px;
    border-color: var(--color-accent-line);
    border-radius: var(--radius);
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    flex-grow: 1;
    margin: 2px;
    -unity-font-style: bold;
}

.confirm-button:hover {
    background-color: rgb(64, 133, 220);
}

.cancel-button {
    font-size: var(--font-size-sm);
    color: var(--color-text-dim);
    background-color: transparent;
    border-width: 1px;
    border-color: var(--color-line);
    border-radius: var(--radius);
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    flex-grow: 1;
    margin: 2px;
    -unity-font-style: bold;
}

.cancel-button:hover {
    color: var(--color-text);
    border-color: var(--color-accent-dim);
    background-color: var(--color-accent-ghost);
}

.stop-button {
    font-size: 15px;
    color: rgb(255, 233, 234);
    background-color: var(--color-danger-deep);
    border-width: 1px;
    border-color: rgb(242, 109, 114);
    border-radius: 9px;
    padding: 11px;
    margin-top: 8px;
    -unity-font-style: bold;
}

.stop-button:hover {
    background-color: rgb(194, 56, 61);
}

.stop-button:active {
    background-color: rgb(140, 32, 37);
}

.button-row {
    flex-direction: row;
    margin-top: 4px;
}

/* ═══ 末端位姿输入 ═══ */
.ee-input-row {
    flex-direction: row;
    align-items: center;
    margin: 2px 0;
}

.ee-label {
    font-size: var(--font-size-sm);
    color: var(--color-text-dim);
    width: 18px;
}

.ee-input {
    font-size: var(--font-size-sm);
    width: 72px;
    margin-right: 4px;
}

/* ═══ 底部状态栏 ═══ */
.status-bar {
    height: var(--statusbar-height);
    min-height: var(--statusbar-height);
    background-color: var(--color-panel);
    flex-direction: row;
    align-items: center;
    padding-left: 12px;
    padding-right: 12px;
    border-width: 1px;
    border-color: var(--color-line);
    border-radius: var(--radius);
    margin-top: 8px;
}

.status-dot-inline {
    width: 7px;
    height: 7px;
    border-radius: 4px;
    margin-right: 7px;
    background-color: var(--color-ok);
}

.status-ready {
    font-size: 11px;
    color: var(--color-ok);
    -unity-font-style: bold;
    margin-right: 14px;
}

.status-message {
    font-size: 11px;
    color: var(--color-text-dim);
    flex-grow: 1;
}

.status-endpoint {
    font-size: 11px;
    color: var(--color-text-faint);
    margin-right: 14px;
}

.status-time {
    font-size: 11px;
    color: var(--color-text-faint);
    -unity-font-style: bold;
}

/* ═══ 参考系 / 下拉 ═══ */
.frame-selector {
    font-size: var(--font-size-sm);
    flex-grow: 1;
}

.mode-hint {
    font-size: 11px;
    color: var(--color-accent);
    padding: 4px 8px;
    margin: 2px 0;
    border-radius: 5px;
    background-color: var(--color-accent-ghost);
    border-width: 1px;
    border-color: var(--color-accent-line);
    -unity-font-style: bold;
}

.plan-status {
    font-size: 11px;
    color: var(--color-text-dim);
    padding: 3px 8px;
    margin: 2px 0;
    border-radius: 5px;
}

.plan-status.planning {
    color: var(--color-warning);
    background-color: var(--color-warning-ghost);
    border-width: 1px;
    border-color: var(--color-warning-line);
}

.plan-status.failed {
    color: var(--color-danger);
    background-color: var(--color-danger-ghost);
    border-width: 1px;
    border-color: var(--color-danger-line);
}

/* ═══ 动画页面 ═══ */
.center-view-anim {
    flex-grow: 1;
    background-color: transparent;
}

.animation-status {
    font-size: 11px;
    padding: 4px 9px;
    border-radius: 5px;
    background-color: var(--color-raise);
    border-width: 1px;
    border-color: var(--color-line-soft);
    color: var(--color-text-dim);
    margin-bottom: 6px;
    -unity-font-style: bold;
}

.animation-status.playing {
    color: var(--color-ok);
    background-color: var(--color-ok-ghost);
    border-color: var(--color-ok-line);
}

.animation-status.paused {
    color: var(--color-warning);
    background-color: var(--color-warning-ghost);
    border-color: var(--color-warning-line);
}

.play-button {
    font-size: var(--font-size-lg);
    color: var(--color-accent-dark);
    background-color: var(--color-accent);
    border-width: 1px;
    border-color: var(--color-accent-line);
    border-radius: 9px;
    padding: 11px;
    margin-top: 8px;
    -unity-font-style: bold;
}

.play-button:hover {
    background-color: rgb(64, 133, 220);
}

.speed-row {
    flex-direction: row;
    align-items: center;
}

.speed-slider {
    flex-grow: 1;
}

.speed-value {
    font-size: var(--font-size-sm);
    color: var(--color-accent);
    width: 52px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

/* 深色下拉（动画模式 / 数据分析通道等代码创建的下拉共用） */
.fx-dropdown .unity-base-popup-field__input,
.fx-dropdown .unity-base-field__input {
    font-size: var(--font-size-sm);
    color: var(--color-accent);
    -unity-font-style: bold;
    background-color: var(--color-raise);
    border-width: 1px;
    border-color: var(--color-line);
    border-radius: 6px;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 8px;
    padding-right: 8px;
}

.fx-dropdown .unity-base-popup-field__input:hover,
.fx-dropdown .unity-base-field__input:hover {
    background-color: rgba(232, 245, 255, 0.86);
    border-color: var(--color-accent);
}

/* 兼容旧类名 */
.animation-mode-dropdown .unity-base-popup-field__input,
.animation-mode-dropdown .unity-base-field__input {
    font-size: var(--font-size-sm);
    color: var(--color-accent);
    -unity-font-style: bold;
    background-color: var(--color-raise);
    border-width: 1px;
    border-color: var(--color-line);
    border-radius: 6px;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 8px;
    padding-right: 8px;
}

.animation-mode-dropdown .unity-base-popup-field__input:hover,
.animation-mode-dropdown .unity-base-field__input:hover {
    background-color: rgba(232, 245, 255, 0.86);
    border-color: var(--color-accent);
}

/* ═══ 样机选择按钮 ═══ */
.prototype-button-row {
    flex-direction: row;
}

.prototype-button {
    flex-grow: 1;
    font-size: 11px;
    color: var(--color-text-dim);
    background-color: var(--color-raise);
    border-width: 1px;
    border-color: var(--color-line);
    border-radius: 6px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 5px;
    padding-right: 5px;
    margin-left: 2px;
    margin-right: 2px;
    -unity-font-style: bold;
}

.prototype-button:hover {
    color: var(--color-text);
    border-color: var(--color-accent-dim);
}

.prototype-button.prototype-button-active {
    color: var(--color-accent);
    background-color: var(--color-accent-ghost);
    border-color: var(--color-accent-line);
}

/* ═══ 特写卡片 ═══ */
.closeup-card {
    background-color: var(--color-raise);
    border-width: 1px;
    border-color: var(--color-line);
    border-radius: 8px;
    padding-top: 7px;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    margin-bottom: 6px;
}

.closeup-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
    padding-left: 9px;
    padding-right: 9px;
}

.closeup-title {
    font-size: var(--font-size-sm);
    color: var(--color-text);
    -unity-font-style: bold;
}

.closeup-badge {
    font-size: 10px;
    color: var(--color-ok);
    background-color: var(--color-ok-ghost);
    border-width: 1px;
    border-color: var(--color-ok-line);
    border-radius: 999px;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 7px;
    padding-right: 7px;
    -unity-font-style: bold;
}

.closeup-image {
    align-self: stretch;
    width: 100%;
    height: 220px;
    background-color: rgba(8, 24, 48, 0.24);
    border-width: 1px;
    border-color: var(--color-line-soft);
    border-radius: 0;
    -unity-background-scale-mode: scale-and-crop;
}

/* ═══ 折线图卡片 ═══ */
.chart-card {
    background-color: var(--color-raise);
    border-width: 1px;
    border-color: var(--color-line-soft);
    border-radius: 6px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 10px;
    padding-right: 10px;
    margin-bottom: 6px;
}

.chart-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2px;
}

.chart-title {
    font-size: var(--font-size-sm);
    color: var(--color-text-dim);
    -unity-font-style: bold;
}

.chart-value {
    font-size: var(--font-size-sm);
    color: var(--color-accent);
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.chart-plot {
    height: 40px;
}

/* ═══ 数据分析页（大折线图，X 轴=时间） ═══ */
.data-center {
    flex-grow: 1;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
}

.data-chart-card {
    flex-grow: 1;
    margin-bottom: 0;
    background-color: var(--color-panel);
    border-color: var(--color-line);
    border-radius: var(--radius);
    padding-top: 10px;
    padding-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
}

.data-chart-body {
    flex-direction: row;
    flex-grow: 1;
}

.data-yaxis {
    width: 56px;
    justify-content: space-between;
    padding-top: 4px;
    padding-bottom: 4px;
}

.data-chart-plot {
    flex-grow: 1;
}

.data-xaxis {
    flex-direction: row;
    justify-content: space-between;
    margin-left: 56px;
    padding-left: 4px;
    padding-right: 4px;
}

.data-axis-label {
    font-size: 10px;
    color: var(--color-text-faint);
}
