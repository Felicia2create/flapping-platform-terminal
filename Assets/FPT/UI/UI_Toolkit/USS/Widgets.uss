/* ═══ 关节滑块行 ═══ */
.joint-slider {
    flex-direction: row;
    align-items: center;
    margin-top: 3px;
    margin-bottom: 3px;
    margin-left: 0;
    margin-right: 0;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 0;
    padding-right: 0;
    background-color: transparent;
    border-width: 0;
}

.joint-name {
    font-size: var(--font-size-sm);
    color: var(--color-text-dim);
    width: 44px;
    -unity-font-style: bold;
}

.joint-slider-bar {
    flex-grow: 1;
    margin-left: 6px;
    margin-right: 6px;
}

/* ═══ 滑块（浅蓝轨道 + 主蓝手柄） ═══ */
.unity-base-slider__tracker {
    background-color: rgba(114, 174, 238, 0.38);
    border-width: 1px;
    border-color: rgba(184, 232, 255, 0.46);
    border-radius: 3px;
    height: 5px;
    margin-top: 0;
    margin-bottom: 0;
}

.unity-base-slider--horizontal .unity-base-slider__dragger {
    width: 14px;
    height: 14px;
    border-radius: 999px;
    background-color: var(--color-accent);
    border-width: 1px;
    border-color: rgba(232, 245, 255, 0.86);
    margin-top: -6px;
}

.unity-base-slider--horizontal .unity-base-slider__dragger:hover {
    background-color: var(--color-accent-dim);
}

.joint-value-input {
    font-size: var(--font-size-sm);
    color: var(--color-accent);
    -unity-font-style: bold;
    width: 64px;
    height: 32px;
}

/* ═══ 输入框 / 下拉（暗色抬升面） ═══ */
.joint-value-input .unity-base-text-field__input,
.ee-input .unity-base-text-field__input,
.frame-selector .unity-base-popup-field__input,
.frame-selector .unity-base-field__input {
    font-size: var(--font-size-sm);
    color: var(--color-accent);
    -unity-font-style: bold;
    background-color: var(--color-raise);
    border-width: 1px;
    border-color: var(--color-line);
    border-radius: 6px;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 8px;
    padding-right: 8px;
    -unity-text-align: middle-center;
}

.joint-value-input .unity-base-text-field__input:focus,
.ee-input .unity-base-text-field__input:focus,
.frame-selector .unity-base-popup-field__input:focus,
.frame-selector .unity-base-field__input:focus {
    background-color: rgba(232, 245, 255, 0.90);
    border-color: var(--color-accent);
}

.joint-unit {
    font-size: var(--font-size-sm);
    color: var(--color-text-faint);
    -unity-font-style: bold;
    width: 14px;
    margin-left: 2px;
}

/* ═══ 位姿输入分组 ═══ */
.pose-display {
    flex-direction: row;
}

.pose-section {
    flex-grow: 1;
    margin: 4px;
}

.pose-section-title {
    font-size: 11px;
    color: var(--color-accent-dim);
    -unity-font-style: bold;
    margin-bottom: 2px;
}

/* ═══ 下拉弹出列表（全局浅蓝，近不透明底） ═══ */
.unity-base-dropdown__container-outer {
    background-color: var(--color-popup);
    border-width: 1px;
    border-color: var(--color-line);
    border-radius: 6px;
}

.unity-base-dropdown__container-inner {
    background-color: var(--color-popup);
}

.unity-base-dropdown__item {
    color: var(--color-text-dim);
    background-color: transparent;
    border-width: 0;
    border-radius: 4px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 10px;
    padding-right: 10px;
    margin-left: 3px;
    margin-right: 3px;
}

.unity-base-dropdown__item:hover {
    color: var(--color-accent);
    background-color: rgba(216, 235, 255, 0.72);
}

.unity-base-dropdown__item:active {
    color: rgb(255, 255, 255);
    background-color: var(--color-accent-dim);
}

.unity-base-dropdown__checkmark {
    color: var(--color-accent);
    -unity-font-style: bold;
}

/* 弹出列表内的滚动条 */
.unity-base-dropdown__container-inner .unity-scroller--vertical {
    background-color: transparent;
}

.unity-base-dropdown__container-inner .unity-scroller__slider {
    background-color: rgba(90, 156, 232, 0.46);
    border-radius: 3px;
}

.unity-base-dropdown__container-inner .unity-scroller__slider:hover {
    background-color: var(--color-accent);
}
